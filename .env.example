SPRING_PROFILES_ACTIVE=local
SERVER_PORT=8080
MANAGEMENT_PORT=9090

DATABASE_URL=jdbc:postgresql://localhost:54321/postgres
DATABASE_USERNAME=postgres
DATABASE_PASSWORD=postgres

POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_PORT=54321
TZ=UTC

CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:3000,http://localhost:5173
OPENAPI_ENABLED=true
P6SPY_ENABLE_LOGGING=true

REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
# 실제 값은 로컬 .env 또는 배포 환경에서 설정한다.
# JWT_SECRET: openssl rand -base64 32로 생성한 값
JWT_SECRET=
# 카카오 디벨로퍼스의 숫자 앱 ID (REST API 키가 아님)
KAKAO_APP_ID=
# dev 프로필에서만 필요. JWT_SECRET과 별도로 생성한 32바이트 이상 비밀값
DEV_MASTER_SECRET=
